{
    "configurations": [
        {
            "name": "ZMK",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/../zmk/app/include",
                "${workspaceFolder}/../zmk/app/src",
                "${workspaceFolder}/../zephyr/include",
                "${workspaceFolder}/../zephyr/dts",
                "${workspaceFolder}/../zephyr/dts/arm",
                "${workspaceFolder}/../zephyr/dts/common",
                "${workspaceFolder}/../modules/**",
                "${workspaceFolder}/../nrfxlib/**",
                "${workspaceFolder}/../cmsis/**"
            ],
            "defines": [
                "CONFIG_RAW_HID",
                "CONFIG_ZMK_DISPLAY",
                "CONFIG_ZMK_DISPLAY_STATUS_SCREEN_CUSTOM",
                "CONFIG_ZMK_WIDGET_BATTERY_STATUS",
                "CONFIG_ZMK_WIDGET_OUTPUT_STATUS",
                "CONFIG_ZMK_WIDGET_LAYER_STATUS",
                "CONFIG_ZMK_WIDGET_WPM_STATUS",
                "CONFIG_ZMK_WIDGET_PERIPHERAL_STATUS",
                "CONFIG_ZMK_LOG_LEVEL=4",
                "CONFIG_USB_DEVICE_STACK",
                "CONFIG_USB_HID_DEVICE_COUNT=2",
                "CONFIG_ENABLE_HID_INT_OUT_EP",
                "CONFIG_I2C",
                "CONFIG_GPIO",
                "__ZEPHYR__=1"
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c17",
            "cppStandard": "gnu++20",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ],
    "version": 4
}